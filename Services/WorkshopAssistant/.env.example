POSTGRES_USER=workshop
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=workshop_knowledge
# Leave blank to use the dedicated pgvector container.
# To reuse an existing database, supply a PostgreSQL URI reachable from Docker.
DATABASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional shared token. If set, also configure WORKSHOP_ASSISTANT_TOKEN in Unity's launch environment.
WORKSHOP_ASSISTANT_TOKEN=
HF_ENDPOINT=https://huggingface.co
# Optional mirrors for networks unable to reach Docker Hub / PyPI.
PYTHON_IMAGE=python:3.12-slim
PIP_INDEX_URL=https://pypi.org/simple
